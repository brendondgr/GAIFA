# TEMPLATE. @ROOT@ is replaced with this clone's absolute path by `gaifa install`.
# Don't edit the installed copy: a reinstall overwrites it.
[Unit]
Description=GAIFA - Great, Another Interface For Agents (http://127.0.0.1:7000)
Documentation=file://@ROOT@/docs/architecture.md

[Service]
# Mods run as their own transient units (gaifa-<id>.service), outside this
# unit's cgroup, so stopping or restarting the hub never stops a mod.
Type=exec
WorkingDirectory=@ROOT@
# The venv's python directly, not `uv run`: no resolver or sync on every boot.
ExecStart=@ROOT@/.venv/bin/python @ROOT@/app.py
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
