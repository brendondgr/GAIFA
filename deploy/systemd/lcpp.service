# TEMPLATE. @REPO_ROOT@ is substituted with this clone's absolute path by
# `lcpp service install` (scripts/install.sh calls it). Do not hardcode a path
# here: a value baked into the installed unit is overwritten on reinstall.
[Unit]
Description=lcpp - llama.cpp model launcher (lcppd on 127.0.0.1:7700)
Documentation=file://@REPO_ROOT@/README.md

[Service]
# Starts no models: instances only ever run when asked for, as their own
# transient units (lcpp-<name>.service). They are outside this unit's cgroup,
# so stopping or restarting lcppd never takes a running model down with it.
Type=exec
WorkingDirectory=@REPO_ROOT@
# The venv's python directly, not `uv run`: no resolver or sync on every boot.
ExecStart=@REPO_ROOT@/.venv/bin/python -m lcpp.daemon
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
