# Copied to ~/.config/gen3d/gen3d.env by install.sh. Uncomment to override; then `gen3d restart`.

# GEN3D_HOST=127.0.0.1            # 0.0.0.0 exposes it to the network; there is no auth
# GEN3D_PORT=5050
# GEN3D_KEEP_ALIVE_S=330          # idle keep-alive; must outlive the browser's (Firefox 115 s, Chrome 300 s)
# GEN3D_DATA=~/Projects/3DGenerate/data   # jobs database + per-job output folders
# GEN3D_IDLE_UNLOAD_S=600          # stop the GPU worker (frees ~20-40 GB) after this long without a job
# GEN3D_PRELOAD=                   # 1 = start the worker at service start

# Where the models live (runtime/CubeArt: weights/, .venv/, cube/; scripts/install-runtime.sh)
# GEN3D_CUBEART=runtime/CubeArt
# GEN3D_IMAGE=docker.io/kyuz0/amd-strix-halo-comfyui:latest
# GEN3D_PODMAN=podman
# GEN3D_BLENDER=blender            # preview renders; empty disables them
# GEN3D_PREVIEW_DEVICE=cpu         # cpu = Mesa llvmpipe (software GL), no GPU work; gpu = faster on big meshes.
#                                  # A choice saved on the page (PUT /v1/settings) wins over this
# GEN3D_STATE_DIR=                 # where that choice is saved (settings.json); empty = GEN3D_DATA
# GEN3D_PREVIEW_MAX_FACES=300000   # simplify bigger meshes for the preview only; 0 = never
# GEN3D_PREVIEW_TIMEOUT_S=180      # kill a preview render that runs longer
# GEN3D_FAKE_WORKER=               # 1 = simulate the GPU (tests / UI work)
