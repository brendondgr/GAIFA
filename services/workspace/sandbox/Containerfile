# The workspace sandbox (plan 27.5): ONLY Python 3.12, uv, Node LTS, git and ripgrep (decided 2026-10-20),
# build-essential for wheels that compile, and the data libraries in requirements.lock.
# Base images are pinned by digest; `aihub`'s workspace page (or `sandbox.py build`) builds it as
# localhost/aihub-workspace-sandbox:<version>. Commands run as your user (--userns=keep-id), so the image
# needs no user of its own.
FROM docker.io/library/node:24-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS node
FROM ghcr.io/astral-sh/uv:0.13.4@sha256:9f130421e930bfbdc563c00740466603f8723158e90297d07957c2294640262b AS uv

FROM docker.io/library/python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
LABEL org.opencontainers.image.title="aihub-workspace-sandbox" \
      org.opencontainers.image.description="AIHub workspace sandbox: Python 3.12, uv, Node LTS, git, ripgrep, build-essential, data libraries"
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep build-essential ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack
COPY --from=uv /uv /uvx /usr/local/bin/
COPY requirements.lock /tmp/requirements.lock
RUN uv pip install --system --no-cache -r /tmp/requirements.lock && rm /tmp/requirements.lock
# uv uses this Python, never downloads one; pip and npm keep caches in $HOME (a tmpfs at run time)
ENV UV_PYTHON=/usr/local/bin/python3.12 UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy \
    PIP_DISABLE_PIP_VERSION_CHECK=1 MPLBACKEND=Agg PYTHONUNBUFFERED=1
