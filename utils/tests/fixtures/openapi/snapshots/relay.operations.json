 {
  "body": {
   "content_type": "application/json",
   "schema": {
    "description": "PUT /admin/registrations/{key}: make an endpoint exist, idempotently.\n\nGive ``port`` for a server on this machine (``host`` defaults to\n127.0.0.1 and the URL becomes ``http://host:port/v1``), or a full\n``base_url``.",
    "properties": {
     "alias": {
      "maxLength": 64,
      "nullable": true,
      "title": "Alias",
      "type": "string"
     },
     "available_models": {
      "items": {
       "type": "string"
      },
      "maxItems": 200,
      "title": "Available Models",
      "type": "array"
     },
     "base_url": {
      "nullable": true,
      "title": "Base Url",
      "type": "string"
     },
     "host": {
      "default": "127.0.0.1",
      "maxLength": 253,
      "title": "Host",
      "type": "string"
     },
     "meta": {
      "additionalProperties": true,
      "title": "Meta",
      "type": "object"
     },
     "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "owner": {
      "default": "external",
      "maxLength": 64,
      "minLength": 1,
      "title": "Owner",
      "type": "string"
     },
     "port": {
      "maximum": 65535.0,
      "minimum": 1.0,
      "nullable": true,
      "title": "Port",
      "type": "integer"
     },
     "server_type": {
      "default": "llama.cpp",
      "enum": [
       "llama.cpp",
       "vLLM",
       "ollama",
       "openai",
       "opencode"
      ],
      "title": "Server Type",
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "title": "RegistrationUpsert",
    "type": "object"
   }
  },
  "description": "",
  "destructive": false,
  "id": "put_admin_registrations_key",
  "method": "PUT",
  "params": [
   {
    "in": "path",
    "name": "key",
