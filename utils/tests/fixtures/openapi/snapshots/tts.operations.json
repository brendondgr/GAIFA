  "tag": "voices",
  "tool": null
 },
 {
  "body": {
   "content_type": "application/json",
   "schema": {
    "properties": {
     "cfg_scale": {
      "description": "Breeze guidance; default 1, or 4 with an instruction",
      "exclusiveMinimum": 0.0,
      "maximum": 10.0,
      "nullable": true,
      "title": "Cfg Scale",
      "type": "number"
     },
     "engine": {
      "default": "auto",
      "enum": [
       "auto",
       "breeze",
       "kokoro"
      ],
      "title": "Engine",
      "type": "string"
     },
     "format": {
      "default": "wav",
      "enum": [
       "wav",
       "flac",
       "mp3",
       "ogg",
       "pcm"
      ],
      "title": "Format",
      "type": "string"
     },
     "instruction": {
      "description": "Breeze: describe the voice (design) or the delivery (direction)",
      "nullable": true,
      "title": "Instruction",
      "type": "string"
     },
     "name": {
      "description": "custom voice name, a Kokoro voice (af_heart...), or omit",
      "nullable": true,
      "title": "Name",
      "type": "string"
     },
     "no_save": {
      "default": false,
      "description": "return the audio only; nothing is written to disk",
      "title": "No Save",
      "type": "boolean"
     },
     "request_id": {
      "description": "client-chosen id (not for stream): sending the same id again, e.g. after a dropped connection, returns that request's result instead of generating again",
      "maxLength": 64,
      "nullable": true,
      "title": "Request Id",
      "type": "string"
     },
     "save_dir": {
      "description": "folder to save into (on the server); relative paths are under the default outputs folder (~/Music/TTS)",
      "nullable": true,
      "title": "Save Dir",
      "type": "string"
     },
     "seed": {
      "default": 42,
      "title": "Seed",
      "type": "integer"
     },
     "speed": {
      "default": 1.0,
      "description": "Kokoro only",
      "exclusiveMinimum": 0.25,
      "maximum": 4.0,
      "title": "Speed",
      "type": "number"
     },
     "stream": {
      "default": false,
      "description": "stream raw PCM s16le as it is generated",
      "title": "Stream",
      "type": "boolean"
     },
     "text": {
      "title": "Text",
      "type": "string"
     },
     "timings": {
      "default": false,
      "description": "return JSON {audio (base64), timings: {duration, words}} instead of audio; Kokoro gives native word times, Breeze is aligned with Whisper",
      "title": "Timings",
      "type": "boolean"
     }
    },
    "required": [
     "text"
    ],
    "title": "SpeechRequest",
    "type": "object"
   }
  },
  "description": "",
  "destructive": false,
  "id": "post_v1_speech",
