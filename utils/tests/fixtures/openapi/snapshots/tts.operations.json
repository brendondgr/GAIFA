 {
  "body": {
   "content_type": "application/json",
   "schema": {
    "properties": {
     "cfg_scale": {
      "default": 4.0,
      "title": "Cfg Scale",
      "type": "number"
     },
     "instruction": {
      "description": "natural-language description of the voice",
      "title": "Instruction",
      "type": "string"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "overwrite": {
      "default": false,
      "title": "Overwrite",
      "type": "boolean"
     },
     "sample_text": {
      "default": "Hello, and welcome. This is a short sample of my voice, recorded so that I sound the same every time you hear me.",
      "title": "Sample Text",
      "type": "string"
     },
     "seed": {
      "default": 42,
      "title": "Seed",
      "type": "integer"
     }
    },
    "required": [
     "name",
     "instruction"
    ],
    "title": "DesignRequest",
    "type": "object"
   }
  },
  "description": "Invent a voice from a description, then keep it as a named voice so it stays consistent.",
  "destructive": false,
  "id": "post_v1_voices_design",
  "method": "POST",
  "params": [],
